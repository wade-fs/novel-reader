<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_paper">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_paper"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_paper"
            app:title="@string/app_name"
            app:titleTextColor="@color/text_primary"
            app:subtitleTextColor="@color/text_secondary"
            app:subtitle="動態載入 / GitHub 連動">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp"
                tools:ignore="RtlSymmetry">

                <!-- 我的書單（切換與刪除已匯入/下載的小說） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBookList"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/book_list"
                    app:icon="@drawable/ic_bookshelf"
                    app:iconTint="@color/primary" />

                <!-- 匯入小說 (支援 GitHub 網址、本機上傳 ZIP/TAR、本機目錄) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportNovel"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="匯入小說 (GitHub/ZIP/目錄)"
                    app:icon="@android:drawable/stat_sys_download"
                    app:iconTint="@color/primary" />

                <!-- 章節目錄 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChapterList"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/chapters"
                    app:icon="@android:drawable/ic_menu_sort_by_size"
                    app:iconTint="@color/text_primary" />

                <!-- 設定 (語速、語調、男生女生) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/settings"
                    app:icon="@android:drawable/ic_menu_preferences"
                    app:iconTint="@color/text_primary" />

                <!-- 切換沉浸全螢幕 (隱藏/顯示狀態列與導航列) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleFullScreen"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="切換沉浸全螢幕"
                    app:icon="@drawable/ic_fullscreen_exit"
                    app:iconTint="@color/text_primary" />
            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- 續讀歷史進度橫條 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResumeBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/primary_container"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/primary"
                    android:contentDescription="續讀" />

                <TextView
                    android:id="@+id/tvResumeProgressText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="上次讀到：第 1 章 · 第 1 段"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResumePlay"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="繼續朗讀"
                    android:textSize="11sp"
                    android:paddingHorizontal="12dp"
                    app:cornerRadius="16dp" />

                <ImageButton
                    android:id="@+id/btnCloseResumeBanner"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/on_primary_container"
                    android:contentDescription="關閉" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 當前章節資訊橫條 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvCurrentChapterInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="載入中..."
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterBadge"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/mode_title_and_body"
                android:textSize="11sp"
                android:textColor="@color/badge_work_record_text"
                app:chipBackgroundColor="@color/badge_work_record"
                app:chipCornerRadius="16dp"
                app:chipStrokeWidth="0dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 章節內文清單 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- 手勢調整提示（亮度 / 語速） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/primary_container"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tvGestureIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:textColor="@color/on_primary_container"
            android:textSize="18sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 底部懸浮播放控制列（Play/Pause 鈕＋滑動手勢區） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomPlayerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <com.novel.reader.ui.PlayerGestureLayout
            android:id="@+id/playerGestureArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 狀態提示小字 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvSpeakingStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_ready"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvVoiceInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0x · 預設"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Play/Pause 鈕：左側上下滑調亮度、右側上下滑調語速；左右滑動切換段落/跨鈕換章 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:paddingStart="8dp"
                        android:text="@string/gesture_hint_left"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:ignore="RtlSymmetry" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabPlayPause"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="@string/play_pause_desc"
                        app:fabSize="normal"
                        app:backgroundTint="@color/primary"
                        app:tint="@color/on_primary"
                        app:srcCompat="@android:drawable/ic_media_play"
                        app:elevation="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:gravity="end"
                        android:paddingEnd="8dp"
                        android:text="@string/gesture_hint_right"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:ignore="RtlSymmetry" />
                </FrameLayout>

            </LinearLayout>

        </com.novel.reader.ui.PlayerGestureLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
